# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# RESEND_API_KEY: Free API key from https://resend.com to guarantee 100% inbox delivery
# without landing in spam. Free tier includes 3,000 emails/month (plenty for 1,000 seats).
RESEND_API_KEY=""

# SENDER_EMAIL: Your verified sender email address on your domain.
SENDER_EMAIL="The Wealth Summit <events@goldenleadershipdevelopment.com>"

# REPLY_TO_EMAIL: Where attendee replies should be routed (use no-reply to prevent receiving any replies).
REPLY_TO_EMAIL="no-reply@goldenleadershipdevelopment.com"

# COORDINATOR_EMAIL: Mobile coordinator email address receiving instant registration alerts on their phone.
COORDINATOR_EMAIL="barmonalice@gmail.com"
